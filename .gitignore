# Build directories 
build/
cmake-build-*/

# Golden corpus (generated by running the Python reference; not source) 

# The capture script that generates them is scripts/capture_golden.py.
# Temporary capture log 
tests/golden/*.log

# Compiled binaries / object files 
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out

# PGO instrumentation artifacts
*.profdata
*.gcda
*.gcno

# LLVM BOLT artifacts  
*.bolt
*.fdata

# Fuzzer corpora and crash artifacts 
fuzz/corpus/
fuzz/crashes/
crash-*
leak-*
timeout-*

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
# Regenerated on each configure
compile_commands.json   

# IDE / editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# clang-tidy / analysis caches 
.cache/
.clangd/

# Python artifacts (reference impl — not our code, but in the repo) 
__pycache__/
*.pyc
*.pyo
*.pyd
